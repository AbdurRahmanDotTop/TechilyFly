---
import Button from './Button.astro';
import TypewriterText from './TypewriterText.astro';

const words = [
  "Virtual Tech Team",
  "Automation Experts",
  "Data Managers",
  "Digital Transformers",
  "Technology Backbone"
];

const stats = [
  { value: "300+", label: "Projects Delivered" },
  { value: "40+", label: "Countries Served" },
  { value: "30%", label: "Average Cost Saving" }
];
---

<section id="hero" class="relative min-h-screen flex items-center justify-center pt-24 md:pt-32 pb-16 overflow-hidden">
  <div id="heroCanvas" class="canvas-container"></div>
  
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
    <div class="text-center max-w-4xl mx-auto space-y-6 md:space-y-8">
      
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-tight">
        <span class="block text-white mb-2">We are your</span>
        <TypewriterText words={words} />
      </h1>
      
      <p class="text-lg sm:text-xl md:text-2xl text-tf-graphite-20 max-w-2xl mx-auto leading-relaxed px-2">
        We handle everything from strategy to execution, AI to analytics, like your in-house Software team would.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6 md:pt-8 w-full px-4 sm:px-0">
        <Button href="/#contact" variant="primary" class="w-full sm:w-auto text-lg px-8 py-4">
          Start Now →
        </Button>
        <Button href="/case-studies" variant="secondary" class="w-full sm:w-auto text-lg px-8 py-4">
          Case Studies
        </Button>
      </div>

      <!-- Stats Row -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 pt-12 md:pt-16 border-t border-white/10 mt-12 md:mt-16">
        {stats.map(stat => (
          <div class="flex flex-col items-center gap-2">
            <span class="text-4xl md:text-5xl font-mono font-bold text-transparent bg-clip-text bg-[image:var(--gradient-signal)]">
              {stat.value}
            </span>
            <span class="text-tf-graphite-40 font-medium uppercase tracking-wider text-xs md:text-sm">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>


