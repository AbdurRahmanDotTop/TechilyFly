---
import GradientHeading from './GradientHeading.astro';
import GlassCard from './GlassCard.astro';

const capabilities = [
  {
    title: "Custom Software Development",
    description: "Scalable web and mobile applications built with modern technologies",
    detail: "Full-stack development using React, Python, Django and cloud-native architectures",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`
  },
  {
    title: "Workflow Automation",
    description: "Streamline operations with intelligent automation solutions",
    detail: "API integrations, and custom workflow engines to eliminate manual tasks",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`
  },
  {
    title: "AI/ML & Data Platforms",
    description: "Harness the power of artificial intelligence and machine learning",
    detail: "Predictive analytics, NLP, computer vision, and data pipeline development",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>`
  },
  {
    title: "Integrations & APIs",
    description: "Connect your systems with seamless integrations",
    detail: "REST APIs, GraphQL, and third-party system integrations",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`
  },
  {
    title: "Dashboards & Analytics",
    description: "Real-time insights with interactive data visualizations",
    detail: "Business intelligence, KPI tracking, and custom reporting solutions",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>`
  },
  {
    title: "DevOps & Infrastructure",
    description: "Scalable cloud infrastructure and deployment automation",
    detail: "AWS, Azure, GCP, Digital Ocean, and CI/CD pipeline setup",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`
  }
];
---

<section id="services" class="py-24 relative overflow-hidden border-t border-white/10">
  <!-- 3D Canvas Background (Initialized via JS) -->
  <div id="capabilities-helix" class="absolute inset-0 z-0 opacity-40 pointer-events-none"></div>
  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <GradientHeading as="h2" class="text-[clamp(2rem,4vw+1rem,3.5rem)] font-extrabold mb-6">
        What We Do
      </GradientHeading>
      <p class="text-[clamp(1.125rem,2vw,1.25rem)] text-tf-graphite-40 max-w-2xl mx-auto">
        We deliver scalable, modern digital solutions to solve your hardest operational challenges.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {capabilities.map((item) => (
        <GlassCard hoverEffect={true} class="p-8 flex flex-col group float-animation" style={`animation-delay: ${Math.random() * 2}s`}>
          <div class="w-16 h-16 rounded-2xl bg-black/40 border border-white/10 flex items-center justify-center text-tf-coral mb-6 group-hover:scale-110 transition-all duration-500 shadow-[inset_0_1px_3px_rgba(255,255,255,0.15),0_4px_10px_rgba(0,0,0,0.6)]">
            <Fragment set:html={item.icon} />
          </div>
          
          <h3 class="text-xl font-semibold mb-3 text-white group-hover:text-tf-coral transition-colors">
            {item.title}
          </h3>
          
          <p class="text-tf-cloud/70 mb-4 flex-grow">
            {item.description}
          </p>
          
          <p class="text-sm text-tf-coral-light">
            {item.detail}
          </p>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<script>
  import { initCapabilitiesHelix } from '../scenes/capabilities-helix';

  document.addEventListener('DOMContentLoaded', () => {
    initCapabilitiesHelix('capabilities-helix');
  });
</script>
