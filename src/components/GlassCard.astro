---
interface Props {
  class?: string;
  hoverEffect?: boolean;
}

const { class: className = '', hoverEffect = false } = Astro.props;
---

<div class={`relative rounded-2xl bg-black/20 border border-white/10 backdrop-blur-md overflow-hidden transition-all duration-500 ease-out ${hoverEffect ? 'hover-3d-card' : ''} ${className}`}>
  <slot />
</div>

<style>
  .hover-3d-card:hover {
    box-shadow: 0 0 30px var(--color-tf-coral-35);
  }
</style>
