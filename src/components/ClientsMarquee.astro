---
import GradientHeading from './GradientHeading.astro';

const clients = [
  { name: "Ethsltd", url: "https://ethsltd.com/" },
  { name: "AndamanAnchorage", url: "https://andamananchorage.com/" },
  { name: "Aethron Global", url: "https://aethronglobal.com/" },
  { name: "Pizza-House.uk", url: "https://pizza-house.uk/" },
  { name: "Rosely Dot In", url: "https://rosely.in" },
  { name: "Asr Foundation", url: "https://asrfoundation.org/" }
];
---

<section id="clients" class="py-16 md:py-24 border-y border-white/10 bg-transparent overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl text-center">
    <div class="mb-12 md:mb-16">
      <GradientHeading as="h3" class="text-2xl md:text-3xl font-bold px-2">
        Trusted By Innovators Worldwide
      </GradientHeading>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-6 lg:gap-8 max-w-5xl mx-auto">
      {clients.map((client) => (
        <a 
          href={client.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group relative px-6 md:px-8 py-3 md:py-4 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md overflow-hidden hover:border-tf-coral/50 hover:bg-tf-coral/10 hover:-translate-y-1 transition-all duration-300 shadow-lg flex items-center justify-center min-w-[140px] sm:min-w-[180px]"
        >
          <div class="absolute inset-0 bg-gradient-to-r from-tf-coral/0 via-tf-coral/10 to-tf-coral/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-xl pointer-events-none"></div>
          <span class="relative z-10 text-white font-mono text-sm md:text-base font-medium group-hover:text-tf-coral transition-colors duration-300">
            {client.name}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
