---
import Button from './Button.astro';

const links = [
  { label: 'Home', href: '/#' },
  { label: 'Services', href: '/#services' },
  { label: 'Process', href: '/#process' },
  { label: 'Testimonials', href: '/#testimonials' },
  { label: 'Clients', href: '/#clients' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Contact', href: '/#contact' },
];
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-4 bg-transparent">
  <div class="container mx-auto px-6 max-w-7xl flex items-center justify-between">
    <!-- Logo -->
    <a href="/#" class="flex items-center">
      <img src="/images/logo.png" alt="Techily Fly" class="h-8 md:h-10 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-8">
        {links.map(link => (
          <li>
            <a href={link.href} class="text-sm font-medium text-tf-cloud hover:text-tf-coral transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href="/#contact" variant="primary" class="!px-5 !py-2 !text-sm">
        Start Now →
      </Button>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Toggle Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Nav Dropdown -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-tf-graphite/95 backdrop-blur-lg border-b border-white/10 md:hidden">
    <div class="container mx-auto px-6 py-4 flex flex-col gap-4">
      {links.map(link => (
        <a href={link.href} class="text-base font-medium text-tf-cloud hover:text-tf-coral transition-colors py-2 border-b border-white/5 last:border-none mobile-link">
          {link.label}
        </a>
      ))}
      <Button href="/#contact" variant="primary" class="w-full mt-2">
        Start Now →
      </Button>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-tf-graphite/80', 'backdrop-blur-md', 'shadow-lg');
      navbar?.classList.remove('bg-transparent', 'py-4');
      navbar?.classList.add('py-2');
    } else {
      navbar?.classList.remove('bg-tf-graphite/80', 'backdrop-blur-md', 'shadow-lg', 'py-2');
      navbar?.classList.add('bg-transparent', 'py-4');
    }
  });

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
