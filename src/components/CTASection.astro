---
import Button from './Button.astro';
---

<section class="py-32 relative overflow-hidden">
  <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
    <h2 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-8 leading-tight">
      <span class="text-transparent bg-clip-text bg-[image:var(--gradient-signal)]">Your Concerns,</span><br/>
      <span class="text-white">Our Solutions</span>
    </h2>
    
    <p class="text-xl text-tf-graphite-20 mb-12 max-w-2xl mx-auto">
      Ready to transform your business with a virtual tech team that acts like your own? Let's discuss your next project.
    </p>
    
    <Button href="/#contact" variant="primary" class="text-lg px-10 py-5">
      Start The Conversation
    </Button>
  </div>
</section>
