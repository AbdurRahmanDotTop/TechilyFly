---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  [key: string]: any;
}

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;

const baseClasses = "inline-flex items-center justify-center font-bold px-6 py-3 rounded-full transition-all duration-300 transform active:scale-95";

const variants = {
  primary: "bg-[image:var(--gradient-signal)] text-white hover:shadow-[0_4px_20px_var(--color-tf-coral-35)] hover:-translate-y-0.5",
  secondary: "bg-white/10 text-white hover:bg-white/20 backdrop-blur-md",
  outline: "border border-tf-coral text-tf-coral hover:bg-tf-coral/10"
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseClasses} ${variants[variant]} ${className}`} {...rest}>
  <slot />
</Tag>
