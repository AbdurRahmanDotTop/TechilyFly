---
import GradientHeading from './GradientHeading.astro';
import GlassCard from './GlassCard.astro';

const steps = [
  {
    num: "01",
    title: "Understand/Strategy",
    description: "Define your business goals and technical requirements",
    detail: "Requirements analysis, technical feasibility, and project roadmap creation"
  },
  {
    num: "02",
    title: "Design",
    description: "Creating intuitive user experiences and system architecture",
    detail: "UI/UX design, system architecture, and database design"
  },
  {
    num: "03",
    title: "Build",
    description: "Agile development with continuous integration and testing",
    detail: "Sprint-based development, code reviews, and automated testing"
  },
  {
    num: "04",
    title: "Deploy",
    description: "Seamless deployment to production with monitoring setup",
    detail: "Cloud deployment, performance optimization, and security hardening"
  },
  {
    num: "05",
    title: "Support",
    description: "Ongoing maintenance, updates, and feature enhancements",
    detail: "24/7 monitoring, regular updates, and continuous improvement"
  }
];
---

<section id="process" class="py-16 md:py-24 lg:py-32 relative bg-transparent overflow-hidden">
  <div id="processCanvas" class="canvas-container"></div>
  
  <div class="w-[95%] mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16 lg:mb-20">
      <GradientHeading as="h2" class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 md:mb-6">
        How We Work
      </GradientHeading>
      <p class="text-lg sm:text-xl text-tf-graphite-20 px-2">
        Our proven methodology for turning complex problems into elegant solutions.
      </p>
    </div>

    <!-- Timeline Layout -->
    <div class="relative w-full mx-auto px-2 sm:px-6">
      
      <!-- Connecting Line (Desktop) - Horizontal Dotted -->
      <div class="hidden lg:block absolute top-[24px] xl:top-[28px] left-[10%] right-[10%] h-[2px] border-t-2 border-dotted border-tf-coral/40 z-0 pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-4 xl:gap-6 relative z-10">
        {steps.map((step, i) => (
          <div class="flex flex-col items-center group relative h-full">
            
            <!-- Connecting Line (Mobile/Tablet) - Vertical Dotted -->
            {i !== steps.length - 1 && (
              <div class="lg:hidden absolute top-[48px] bottom-[-32px] left-1/2 w-[2px] -translate-x-1/2 border-l-2 border-dotted border-tf-coral/30 z-0 pointer-events-none"></div>
            )}

            <!-- Number Circle -->
            <div class="w-12 h-12 xl:w-14 xl:h-14 rounded-full bg-tf-graphite border-2 border-tf-coral flex items-center justify-center text-white text-base xl:text-lg font-bold font-mono group-hover:scale-110 group-hover:bg-tf-coral transition-all duration-300 shadow-[0_0_15px_var(--color-tf-coral-35)] z-10 relative shrink-0">
              {step.num}
            </div>

            <!-- Dotted Line Connecting Number to Card -->
            <div class="w-[2px] h-4 xl:h-6 border-l-2 border-dotted border-tf-coral/60 my-1 xl:my-2 z-10 pointer-events-none"></div>

            <!-- GlassCard Box -->
            <GlassCard hoverEffect={true} class="p-6 md:p-8 xl:p-10 relative overflow-hidden flex flex-col items-center text-center w-full flex-grow hover:-translate-y-2 transition-transform duration-300 group/card">
              <div class="absolute -top-4 -right-4 p-4 opacity-5 group-hover/card:opacity-10 transition-opacity duration-300 pointer-events-none">
                <span class="text-8xl xl:text-9xl font-black italic">{step.num}</span>
              </div>
              
              <h4 class="text-2xl md:text-3xl font-bold text-white mb-3 md:mb-4 group-hover/card:text-tf-coral-light transition-colors duration-300 relative z-10">{step.title}</h4>
              <p class="text-base md:text-lg text-tf-graphite-20 mb-6 md:mb-8 flex-grow relative z-10 leading-relaxed">{step.description}</p>
              
              <div class="mt-auto relative z-10 w-full">
                <span class="text-sm md:text-base font-mono text-tf-coral-light bg-tf-coral/10 py-2 md:py-3 px-3 md:px-4 rounded-xl border border-tf-coral/20 inline-block w-full">
                  {step.detail}
                </span>
              </div>
            </GlassCard>
            
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
