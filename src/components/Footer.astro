          </div>
          
          <div class="flex flex-wrap items-center gap-4 pt-4">
            <a href="https://facebook.com/techilyfly" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-tf-graphite-40 hover:text-white hover:bg-[#1877F2] hover:-translate-y-1 hover:shadow-[0_4px_15px_rgba(24,119,242,0.4)] transition-all duration-300" aria-label="Facebook">
